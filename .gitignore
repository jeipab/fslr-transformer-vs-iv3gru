# Python
__pycache__/
*.pyc
*.ipynb

# Virtual Environments
.venv/
env/
venv/
venv311/

# Archive
.archive/

# Streamlit
.streamlit/Guides/

# Data Directory Structure
# Ignore everything in data/ by default
data/*

# Allow specific data subdirectories and files
!data/__init__.py
!data/resize_360p.py
!data/demo/
!data/demo/**
!data/labels/
!data/splitting/
!data/splitting/**
!data/color_correction/
!data/color_correction/**

# Exclude pycache in allowed data directories
data/labels/__pycache__/
data/labels/**/*.pyc
data/splitting/__pycache__/
data/splitting/**/*.pyc

# Data File Formats
*.npy
*.csv
*.npz
*.parquet

# Video Files
*.mp4
*.avi
*.mov

# Notebooks folder
notebooks/

# Tool folder
android/

# Exception: Allow demo files
!data/demo/*.npz
!data/demo/*.mov
!data/demo/*.MOV

# Exception: Allow specific CSV files
!data/labels_reference.csv

# Model Checkpoints (ignore all model files)
*.pt
*.pth

# Note: Best model files are also ignored
# If you want to track best models, uncomment the line below:
# !trained_models/**/*_best.pt

# Track specific best model checkpoints
!trained_models/transformer/greetings_classification/SignTransformer_best.pt
!trained_models/transformer/greetings_ctc_v2/SignTransformerCtc_best.pt
!trained_models/iv3_gru/greetings_classification/InceptionV3GRU_best.pt
!trained_models/iv3_gru/greetings_ctc_v2/InceptionV3GRUCtc_best.pt
!trained_models/mediapipe_gru/greetings_classification/MediaPipeGRU_best.pt
!trained_models/mediapipe_gru/greetings_ctc_v4/MediaPipeGRUCtc_best.pt

# Exception: Allow shared directory
!shared/
!shared/**