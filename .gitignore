# ======================================================
# 🐍 Python
# ======================================================
__pycache__/
*.pyc
*.ipynb

# ======================================================
# 🧩 Virtual Environments
# ======================================================
.venv/
env/
venv/
venv311/

# ======================================================
# 🗃️ Archives & Temporary Files
# ======================================================
.archive/

# ======================================================
# 🖥️ Streamlit
# ======================================================
.streamlit/Guides/

# ======================================================
# 📁 Data Directory Structure
# ======================================================

# Ignore everything in data/ by default
data/*

# Allow core scripts or initialization files
!data/__init__.py
!data/resize_360p.py

# ------------------------------
# Allow specific subdirectories
# ------------------------------

# Demo data (for sample showcases)
!data/demo/
!data/demo/**

# Labels (metadata or annotation files)
!data/labels/

# Data splitting configurations
!data/splitting/
!data/splitting/**

# Color correction utilities
!data/color_correction/
!data/color_correction/**

# ------------------------------
# Selective un-ignore for processed/raw data
# ------------------------------

# Processed data: only track "pro_continuous_sequences"
!data/processed/
data/processed/*
!data/processed/pro_continuous_sequences/
!data/processed/pro_continuous_sequences/**

# Raw data: only track "raw_continuous_sequences"
!data/raw/
data/raw/*
!data/raw/raw_continuous_sequences/
!data/raw/raw_continuous_sequences/**

# ------------------------------
# Exclude caches inside allowed data dirs
# ------------------------------
data/labels/__pycache__/
data/labels/**/*.pyc
data/splitting/__pycache__/
data/splitting/**/*.pyc

# ------------------------------
# Allow specific CSV reference
# ------------------------------
!data/labels_reference.csv

# ======================================================
# 📓 Notebooks & Tools
# ======================================================
notebooks/
android/

# ======================================================
# 🧠 Model Checkpoints
# ======================================================

# Ignore all model weights by default
*.pt
*.pth

# Track only specific best model checkpoints
!trained_models/transformer/greetings_classification/SignTransformer_best.pt
!trained_models/transformer/greetings_ctc_v2/SignTransformerCtc_best.pt
!trained_models/iv3_gru/greetings_classification/InceptionV3GRU_best.pt
!trained_models/iv3_gru/greetings_ctc_v2/InceptionV3GRUCtc_best.pt
!trained_models/mediapipe_gru/greetings_classification/MediaPipeGRU_best.pt
!trained_models/mediapipe_gru/greetings_ctc_v4/MediaPipeGRUCtc_best.pt

# ======================================================
# 🤝 Shared Resources
# ======================================================
!shared/
!shared/**