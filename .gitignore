# Python
__pycache__/
*.pyc
.venv/
env/

# User Specific Folders
venv311/
venv/
raw/
.archive/

# Data (ignore everything inside data/)
data/*

# Allow tracking in data
!data/splitting/
!data/splitting/**
!data/labels/
!data/__init__.py
!data/resize_360p.py
!data/demo/
!data/demo/**

# Exclude specific files/directories within allowed data directories
data/labels/__pycache__/
data/labels/**/*.pyc
data/splitting/__pycache__/
data/splitting/**/*.pyc

# Other Data Formats
*.npy
*.csv
*.mp4
*.avi
*.mov
*.npz
*.parquet

# Allow specific CSV files
!preprocessing/utils/rename.csv

# Checkpoints
*.pt
*.pth

# Allow only the "best" model files
!trained_models/**/*_best.pt

# Allow shared/ to be tracked despite global ignores
!shared/
!shared/**