# Python
__pycache__/
*.pyc

# Virtual Environments
.venv/
env/
venv/
venv311/

# Archive
.archive/

# Data Directory Structure
# Ignore everything in data/ by default
data/*

# Allow specific data subdirectories and files
!data/__init__.py
!data/resize_360p.py
!data/demo/
!data/demo/**
!data/labels/
!data/splitting/
!data/splitting/**

# Exclude pycache in allowed data directories
data/labels/__pycache__/
data/labels/**/*.pyc
data/splitting/__pycache__/
data/splitting/**/*.pyc

# Data File Formats
*.npy
*.csv
*.npz
*.parquet

# Video Files
*.mp4
*.avi
*.mov

# Exception: Allow specific CSV files
!preprocessing/utils/rename.csv

# Model Checkpoints
*.pt
*.pth

# Exception: Allow best model files
!trained_models/**/*_best.pt

# Exception: Allow shared directory
!shared/
!shared/**
