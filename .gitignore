# ======================================================
# 🐍 Python
# ======================================================
__pycache__/
*.pyc
*.ipynb

# ======================================================
# 🧩 Virtual Environments
# ======================================================
.venv/
env/
venv/
venv311/

# ======================================================
# 🗃️ Archives & Temporary Files
# ======================================================
.archive/

# ======================================================
# 🖥️ Streamlit
# ======================================================
.streamlit/Guides/

# ======================================================
# 📁 Data Directory Structure
# ======================================================

# Ignore everything in data/ by default
data/**
metrics/temporal alignment/visualizations/

# Allow core scripts or initialization files
!data/__init__.py

# ------------------------------
# Allow specific subdirectories
# ------------------------------

# Demo data (for sample showcases)
!data/demo/
!data/demo/**

# Labels (metadata or annotation files)
!data/labels/

# Data splitting configurations
!data/splitting/
!data/splitting/**

# ------------------------------
# Exclude caches inside allowed data dirs
# ------------------------------
data/labels/__pycache__/
data/labels/**/*.pyc
data/splitting/__pycache__/
data/splitting/**/*.pyc

# ------------------------------
# Allow specific CSV reference
# ------------------------------
!data/labels_reference.csv
!data/processed/
!data/processed/labels.csv
!data/processed/FSL105_train.csv
!data/processed/FSL105_val.csv
!data/processed/training/
!data/processed/training/train.csv
!data/processed/training/val.csv
!data/processed/sample/
!data/processed/sample/**

# ------------------------------
# Allow raw fix script only
# ------------------------------
!data/raw/
data/raw/**
!data/raw/fix_occlusion.py

# ======================================================
# 📓 Notebooks & Tools
# ======================================================
notebooks/
android_artifacts/

# ======================================================
# 🧠 Model Checkpoints
# ======================================================

# Ignore all model weights by default
*.pt
*.pth

# Track only specific best model checkpoints
!trained_models/transformer/FSL105_classification/SignTransformer_best.pt
!trained_models/transformer/FSL105_ctc/SignTransformerCtc_best.pt
!trained_models/iv3_gru/FSL105_classification/InceptionV3GRU_best.pt
!trained_models/iv3_gru/FSL105_ctc/InceptionV3GRUCtc_best.pt
!trained_models/mediapipe_gru/FSL105_classification/MediaPipeGRU_best.pt
!trained_models/mediapipe_gru/FSL105_ctc/MediaPipeGRUCtc_best.pt

# ======================================================
# 🤝 Shared Resources
# ======================================================
!shared/
!shared/**